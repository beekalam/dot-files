#! /bin/bash


# no args open ranger in PWD
if [ $# -eq 0 ]
then
    emacsclient -n --eval "(dired \"$PWD\")" && wmctrl -a 'emacs'
    exit
fi

# A path was given open ranger
if [ -d $1 ]
then
    echo "should"
    if [[ "$1" == "." ]]; then
        echo "in if"
        echo "(ranger \"$PWD\")"
        emacsclient -n --eval "(dired \"$PWD\")" && wmctrl -a 'emacs'
        exit
    else
        emacsclient -n --eval "(dired \"$1\")" && wmctrl -a 'emacs'
        # emacsclient -n $PWD && wmctrl -a 'emacs'
        exit
    fi
fi

if [ -L $1 ]; then
    filepath=`realpath $1`
else
    filepath=$1
fi


if [[ ! -f "$filepath" ]]
then
    echo -n "'$filepath' does not exist create:"
    read  ans
    if [[ "$ans" == "y" ]]; then
        echo "$PWD/$filepath"
    else
        exit
    fi
fi


emacsclient -n $filepath && wmctrl -a 'emacs'
