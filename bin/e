#! /bin/bash

if [ $# -eq 0 ]
then
    # echo "No arguments supplied"
    emacsclient -n $PWD && wmctrl -a 'emacs'
    exit
fi

if [ -d $1 ]
then
    emacsclient -n $PWD && wmctrl -a 'emacs'
fi

if [ -L $1 ]; then
    filepath=`realpath $1`
else
    filepath=$1
fi


if [[ ! -f "$filepath" ]]
then
    echo "$filepath does not exist"
    exit
fi


emacsclient -n $filepath && wmctrl -a 'emacs'

