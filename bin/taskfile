#!/usr/bin/env bash

function i_emacs {
    sudo apt install emacs -y
}

function i_htop {
    sudo apt install htop -y
}

function i_fzf {
    sudo apt install fzf -y
}

function i_ncurses {
    sudo apt install libncurses-dev
}

function i_build_essentials {
    sudo apt install build-essential -y
    sudo apt install gdb -y
}
function i_git {
    sudo apt install git -y
}

function i_lf {
    sudo apt install lf
}

function i_ytdlp {
    cd ~
    wget -c https://github.com/yt-dlp/yt-dlp/releases/download/2026.08.19/yt-dlp_linux
    chmod +x ./yt-dlp_linux
    mkdir -p .opt
    mv yt-dlp_linux .opt
    ln -s ~/.opt/yt-dlp_linux /usr/local/bin/yt-dlp
}

function i_guix {
    wget https://guix.gnu.org/guix-install.sh
    chmod +x guix-install.sh
    yes | ./guix-install.sh
    # echo 'GUIX_PROFILE="$HOME/.guix-profile"' >> $HOME/.bashrc
    echo 'GUIX_PROFILE=/root/.guix-profile' >> ~$HOME/.bashrc
    echo 'PATH=$PATH:$HOME/.guix-profile/bin/' >> $HOME/.bashrc
    source $HOME/.bashrc
}

function i_install_with_guix {
    guix package -i guile lf git gdb emacs htop
}

function i_all {
    sudo apt update
    i_emacs
    i_htop
    i_fzf
    i_build_essentials
    i_git
    i_incurses
    i_lf
}

function app:super {
    exec /mnt/dd/opt/superProductivity-x86_64.AppImage > /dev/null 2>&1 &
}

function notify {
    XDG_RUNTIME_DIR=/run/user/$(id -u) notify-send  "$1"
}

function tor:disable_proxy {
    printf 'AUTHENTICATE\\r\\nRESETCONF Socks5Proxy\\r\\nQUIT\\r\\n' | nc 127.0.0.1 9051
    echo "done"
}

function tor:change_ip {
    # printf 'AUTHENTICATE\\r\\nSIGNAL NEWNYM\\r\\nQUIT\\r\\n' | nc -N 127.0.0.1 9051
    tor:ip
    printf 'AUTHENTICATE\r\nSIGNAL NEWNYM\r\nQUIT\r\n' | nc -N 127.0.0.1 9051
    tor:ip
}

function tor:ip {
    curl --socks5-hostname 127.0.0.1:9050 https://check.torproject.org/api/ip
}

function tor:restart {
    sudo service tor restart
    tor:logs
}

function tor:logs {
    journalctl -u  tor@default.service -f
}


function livebook:start {
    cd /mnt/df/src/livebook-0.19.8
    ./taskfile start
}

function mix:new {
    local proj
    if [[ $# -ne 1 ]]; then
        read -p "proj: " proj
    else
        echo "project name was given"
        proj="$1"
    fi

    mix phx.new "${proj}" --database sqlite3
}

function iex:start {
    export ERL_AFLAGS="-kernel shell_history enabled"
    iex
}


function c_dotfiles {
    git clone https://github.com/beekalam/dot-files/
    mv dot-files .dot-files
}


function c_book {
    git clone https://github.com/PacktPublishing/Hands-on-System-Programming-with-Linux
}


function setup:dot_files {
    if grep -qsF '. ~/.dot-files/.bashrc' "$HOME/.bashrc"; then
        echo "already in bashrc"
    else
        echo '. ~/.dot-files/.bashrc' >> .bashrc
    fi
}

function killer {
    echo "in killer"
    setup:dot_files
    # i_all
    # c_dotfiles
    #c_book
}

function l {
    res=`taskfile | fzf | awk '{print $2}'`
    trimmed_res=$(printf '%s' "$res" | awk '{ sub(/^[[:space:]]+/, ""); print }')
    # echo "ts: $trimmed_res"
    taskfile "$trimmed_res"
}

function help_func {
    read -p "function name:" name
    sed -n "\|^function ${name}|,\|^}|p" ~/.dot-files/bin/taskfile
}

function mk {
    res=`maak -f /mnt/df/src/todo-app/maak.scm --list | fzf --ansi`
    echo "$res"
    maak -f /mnt/df/src/todo-app/maak.scm "$res"
}

function default {
    help
}

function help {
    echo "$0 <task> <args>"
    echo "Tasks:"
    compgen -A function | cat -n
    # compgen -A function | grep "^cmd_"
}

TIMEFORMAT="Task completed in %3lR"
time ${@:-default}
